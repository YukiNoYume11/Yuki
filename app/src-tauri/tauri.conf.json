{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClaudeMusic",
  "version": "0.3.0",
  "identifier": "local.claudemusic",
  "build": {
    "frontendDist": "../../webui"
  },
  "app": {
    "windows": [
      {
