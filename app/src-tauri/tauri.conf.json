{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YukiMusic",
  "version": "1.0.0",
  "identifier": "local.claudemusic",
  "build": {
    "frontendDist": "../../webui"
  },
  "app": {
    "windows": [
      {
        "title": "YukiMusic",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 620,
        "center": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}